# (optional) Port used by the server
PORT=3000
# Postgres user name
DB_USER=admin
# Postgres password
DB_PASSWORD=some_strong_password
# Postgres database name
DB_NAME=market
# Postgres database host (in Docker should point to service name)
DB_HOST=pgbouncer
# Postgres database port
DB_PORT=5433
# Postgres full connection url
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# (optional) Takes precedence over DB_URL; used internally only for testing purposes
TEST_DB_URL=
# (optional) Pact broker
PACT_BROKER_URL=http://127.0.0.1:20201
# (optional) Enable TypeORM logs (e.g., error,query)
# TYPE_ORM_LOG_LEVEL=error,query
# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbit:5672
# Redis (cache)
REDIS_CACHE_HOST=redis
REDIS_CACHE_PORT=6379
REDIS_URL=redis://${REDIS_CACHE_HOST}:${REDIS_CACHE_PORT}
# Redis (jobs)
REDIS_JOBS_HOST=redis-jobs
REDIS_JOBS_PORT=6379
REDIS_JOBS_URL=redis://${REDIS_JOBS_HOST}:${REDIS_JOBS_PORT}
# Rate limit window in seconds
RATE_LIMIT_TTL=60
# Rate limit number of requests per window
RATE_LIMIT_LIMIT=100
