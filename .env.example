# (optional) Port used by the server
PORT=3000
# Postgres user name
DB_USER=admin
# Postgres password
DB_PASSWORD=some_strong_password
# Postgres database name
DB_NAME=market
# Postgres database host (in Docker should point to service name)
DB_HOST=pgbouncer
# Postgres database port
DB_PORT=5433
# Postgres full connection url
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# (optional) Takes precedence over DB_URL; used internally only for testing purposes
TEST_DB_URL=
# (optional) Pact broker
PACT_BROKER_URL=http://127.0.0.1:20201
