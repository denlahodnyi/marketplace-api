{
  "name": "marketplace-api",
  "version": "1.0.0",
  "author": "Den Lahodnyi",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "lint:oas": "redocly lint --extends minimal ./openapi/openapi.yaml",
    "swagger:dev": "python3 -m http.server 5100 --directory ./openapi",
    "check:env": "node --no-deprecation --disable-warning=ExperimentalWarning --loader ts-node/esm ./scripts/check-env-example.ts",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "fmt": "oxfmt src/ test/",
    "fmt:check": "oxfmt --check src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:contract": "vitest run --config ./vitest.config.consumer-contract.ts",
    "verify:provider": "vitest run --config ./vitest.config.provider-contract.ts",
    "migrate": "bash scripts/with-secrets.sh && typeorm-ts-node-esm migration:run -d src/data-source.ts",
    "migrate:revert": "bash scripts/with-secrets.sh && typeorm-ts-node-esm migration:revert -d src/data-source.ts",
    "migrate:generate": "bash scripts/with-secrets.sh && typeorm-ts-node-esm migration:generate -d src/data-source.ts --pretty src/migrations/$NAME",
    "migrate:show": "bash scripts/with-secrets.sh && typeorm-ts-node-esm migration:show -d src/data-source.ts",
    "drop-schema": "bash scripts/with-secrets.sh && typeorm-ts-node-esm schema:drop -d src/data-source.ts",
    "backup": "bash scripts/backup.sh",
    "backup:drill": "bash scripts/restore-drill.sh",
    "seed": "bash scripts/with-secrets.sh && node --no-deprecation --disable-warning=ExperimentalWarning --loader ts-node/esm src/seed.ts",
    "demo:nplus1": "bash scripts/with-secrets.sh && node --no-deprecation --disable-warning=ExperimentalWarning --loader ts-node/esm src/demo/orm/demo-nplus1.ts",
    "demo:report": "bash scripts/with-secrets.sh && node --no-deprecation --disable-warning=ExperimentalWarning --loader ts-node/esm src/demo/orm/report.ts",
    "demo:race": "bash scripts/with-secrets.sh && node --no-deprecation --disable-warning=ExperimentalWarning --loader ts-node/esm src/demo/concurrency/race.ts",
    "demo:workers": "bash scripts/with-secrets.sh && node --no-deprecation --disable-warning=ExperimentalWarning --loader ts-node/esm src/demo/concurrency/queue.ts",
    "demo:retry": "bash scripts/with-secrets.sh && node --no-deprecation --disable-warning=ExperimentalWarning --loader ts-node/esm src/demo/concurrency/retry.ts",
    "demo:realtime": "bash scripts/with-secrets.sh && node --no-deprecation --disable-warning=ExperimentalWarning --loader ts-node/esm src/demo/realtime/realtime-demo.ts"
  },
  "scarfSettings": {
    "enabled": false
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.23.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "~12.1.3",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "~12.1.3",
    "@redocly/cli": "2.47.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.52.0",
    "express": "5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "typeorm": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@pact-foundation/pact": "^17.1.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxfmt": "0.65.0",
    "oxlint": "^1.58.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
