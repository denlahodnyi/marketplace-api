{
  "consumer": {
    "name": "MyConsumer"
  },
  "interactions": [
    {
      "description": "a request for all products",
      "providerStates": [
        {
          "name": "I have a list of products"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/products"
      },
      "response": {
        "body": [
          {
            "currency": "USD",
            "description": "",
            "name": "Lego",
            "price": 12300,
            "productId": "d3c8c454-7313-4426-9498-bcb8851fd7e1"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.3"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "MyProvider"
  }
}